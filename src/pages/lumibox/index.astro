---
import Base from '../../layouts/Base.astro';
import { getT } from '../../i18n/utils';

const t = getT('zh');
const app = t.apps.lumibox;
import { buildAppJsonLd } from '../../data/seo';
const appJsonLd = buildAppJsonLd(app, 'lumibox', 'zh', '/lumibox');
---
<Base
  jsonLd={appJsonLd}
  title="拾光匣 LumiBox · NAS 私有相册同步与浏览 App - 小安之家"
  description={app.desc}
  lang="zh"
>

<!-- Hero (dark) -->
<section class="hero sec-dark" id="top">
  <div class="wrap">
    <p class="eyebrow">拾光匣</p>
    <h1>你的照片<br>始终在你掌控之间</h1>
    <p class="lead">{app.desc}</p>
    <p class="hero-sub"><img src="/images/icon-harmonyos.svg" class="pi" alt="" width="22" height="22" style="width:22px;height:22px">HarmonyOS App</p>
    <div class="hero-device" style="padding-bottom:60px">
      <div class="app-showcase" style="transform:translateY(40px)">
        <img src="/images/lumibox-icon.png" alt="拾光匣图标" class="showcase-icon" width="140" height="140" />
      </div>
    </div>
  </div>
</section>

<!-- Feature spotlights (dark) -->
<section class="sec-dark" id="features">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">为什么选择拾光匣</p>
      <h2>备份、浏览、一气呵成</h2>
      <p class="lead">连接群晖 NAS 或 Immich，将华为手机相册与私有相册服务无缝打通，照片数据始终在你自己手中。</p>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>不止群晖<br>开源相册 Immich支持</h2>
        <p class="lead">除了群晖 NAS，拾光匣现在也支持连接 Immich——无论是自建的开源相册服务，还是部署在云主机上的私有实例，都能一样流畅同步、浏览。群晖用户不受影响，Immich 用户终于也有了原生鸿蒙客户端。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/lumibox/feature-server-choice.webp"
            alt="支持群晖 NAS 与 Immich 双服务端的示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot rev reveal">
      <div class="spot-text">
        <h2>动态照片<br>上传照样会动</h2>
        <p class="lead">拾光匣完整识别鸿蒙动态照片格式，上传时保留动态效果，浏览时按住就动、松手就停——动态照片因备份而变成静态图的时代结束了。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/lumibox/feature-live-photo.webp"
            alt="动态照片上传后仍保留动态效果的示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>HDR Vivid<br>色彩一分不少</h2>
        <p class="lead">打开拾光匣，支持的华为设备自动以 HDR Vivid 渲染意图播放照片与视频——手机拍出来多亮丽，浏览时依旧亮丽。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/lumibox/feature-hdr-vivid.webp"
            alt="HDR Vivid 高动态范围色彩预览示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot rev reveal">
      <div class="spot-text">
        <h2>增量同步<br>传过的不再传</h2>
        <p class="lead">Delta 同步策略让拾光匣只传服务端上还没有的文件。断点续传，中途断网也能从断点继续——不用重头开始，不浪费一次流量。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/lumibox/feature-delta-sync.webp"
            alt="增量同步与断点续传示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>相册时间线<br>翻起来像在手机里</h2>
        <p class="lead">按年、月、日浏览服务端里的全部照片，目录结构完整保留——打开相册那一刻，和打开手机相册一样自然熟悉。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/lumibox/feature-timeline.webp"
            alt="按年月日浏览的相册时间线示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot rev reveal">
      <div class="spot-text">
        <h2>你的照片<br>只在你的设备之间</h2>
        <p class="lead">照片直连你配置的群晖 NAS 或 Immich 服务，绝不经过第三方云中转。可视化缓存管理，一键清理缩略图与预览缓存——存储怎么用，你说了算。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/lumibox/feature-local-control.webp"
            alt="照片仅在本机与私有服务端之间直连传输示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>选择性目录备份<br>隐私掌控感极强</h2>
        <p class="lead">无论是群晖备份还是 Immich 备份，你都可以精确选择要上传的目录——第一次真正掌控自己的照片上传范围，而不是被动把整部手机交出去。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/lumibox/feature-selective-backup.webp"
            alt="选择性目录备份、精确选择上传范围的示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Feature grid (light) -->
<section class="sec-light">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">更多功能</p>
      <h2>每个细节都用心</h2>
    </div>
    <div class="grid">
      {app.features.map(f => (
        <div class="cell reveal">
          <div class="cell-ico">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Platform (darker) -->
<section class="sec-darker" id="platforms">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">平台</p>
      <h2>为华为而生</h2>
    </div>
    <div class="plats" style="grid-template-columns:1fr">
      <div class="plat reveal" style="max-width:560px;margin:0 auto">
        <span class="plat-tag">HarmonyOS</span>
        <h3>鸿蒙原生 App</h3>
        <ul>
          <li>ArkTS 原生开发，适配鸿蒙设计规范</li>
          <li>HDR Vivid 渲染，动态照片完整支持</li>
          <li>支持群晖 Synology NAS 与 Immich 双服务端</li>
          <li>断点续传，增量同步</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Download (light) -->
<section class="sec-light get" id="get">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">立即获取</p>
      <h2>下载拾光匣</h2>
      <p class="lead">华为 AppGallery 免费下载。</p>
    </div>
    <div class="get-cards get-cards-2">
      <div class="get-card reveal">
        <img src="/images/icon-appgallery.svg" alt="" width="80" height="80" loading="lazy">
        <h3>华为应用市场</h3>
        <p>拾光匣已上架华为应用市场，鸿蒙设备可直接下载安装。</p>
        <a class="btn btn-primary" href="https://appgallery.huawei.com/app/detail?id=com.lumibox.app" target="_blank" rel="noopener">立即下载</a>
      </div>
      <div class="get-card reveal">
        <img class="qr-real" src="/images/lumibox-qrcode.png" alt="拾光匣华为应用市场下载二维码" width="120" height="120" loading="lazy" />
        <h3>扫码下载</h3>
        <p>使用华为应用市场扫一扫，或手机相机识别二维码下载。</p>
        <a class="btn btn-primary" href="https://appgallery.huawei.com/app/detail?id=com.lumibox.app" target="_blank" rel="noopener">打开下载页</a>
      </div>
    </div>
  </div>
</section>

<div class="legal-links">
  <a href="/lumibox/privacy-policy">隐私政策</a>
  {' · '}
  <a href="/lumibox/user-agreement">用户协议</a>
  {' · '}
  <a href="/lumibox/auto-renewal-agreement">自动续费服务协议</a>
  {' · '}
  <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">京ICP备2026021298号-5A</a>
</div>

</Base>
