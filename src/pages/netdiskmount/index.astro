---
import Base from '../../layouts/Base.astro';
import { getT } from '../../i18n/utils';

const t = getT('zh');
const app = t.apps.autovolume;
import { buildAppJsonLd } from '../../data/seo';
import ProductCrossLinks from '../../components/ProductCrossLinks.astro';
const appJsonLd = buildAppJsonLd(app, 'autovolume', 'zh', '/netdiskmount');
const repoUrl = 'https://github.com/mengyuefeitian/AutoVolume';
---
<Base
  jsonLd={appJsonLd}
  title="NetDiskMount · macOS 网络磁盘与 NAS 自动挂载工具 - 小安之家"
  description={app.desc}
  lang="zh"
>

<section class="hero sec-dark" id="top">
  <div class="wrap">
    <p class="eyebrow">NetDiskMount · v{app.version}</p>
    <h1>让 NAS 和网盘<br>一直挂在 Mac 上</h1>
    <p class="lead">{app.desc}</p>
    <p class="hero-sub"><img src="/images/icon-macos.svg" class="pi" alt="macOS 图标" width="17" height="17">macOS 菜单栏应用 · 网络磁盘自动挂载与断线重连</p>
    <div class="hero-device" style="padding-bottom:60px">
      <div class="app-showcase" style="transform:translateY(40px)">
        <img src="/images/autovolume-icon.png" alt="NetDiskMount 图标" class="showcase-icon" width="140" height="140" />
      </div>
    </div>
    <p style="margin-top:72px">
      <a class="btn btn-outline" href={repoUrl} target="_blank" rel="noopener"><img src="/images/icon-github.svg" alt="" width="18" height="18" style="filter:invert(1)" aria-hidden="true">在 GitHub 查看项目</a>
    </p>
  </div>
</section>

<section class="sec-dark" id="features">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">为什么选择 NetDiskMount</p>
      <h2>挂上一次，之后不用再管</h2>
      <p class="lead">断网、休眠、换 Wi-Fi 之后，网络文件夹自己回来。</p>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>自动重连<br>断线静默恢复</h2>
        <p class="lead">网络断开又恢复、Mac 从睡眠中醒来之后，自动把网络文件夹重新挂上。不用再打开访达「连接服务器」，也不会弹窗打扰。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-reconnect.webp"
            alt="网络恢复后静默自动重连挂载示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot rev reveal">
      <div class="spot-text">
        <h2>一次配置<br>开机即用</h2>
        <p class="lead">服务器地址、路径、账号、密码和挂载位置保存一次就好，之后开机自动挂载。也能只挂共享里的某个子目录，例如 smb://nas.local/share/tools。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-subdir.webp"
            alt="挂载服务器子目录并保存配置示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>NTFS 移动硬盘<br>插上就能写</h2>
        <p class="lead">突破 macOS 对 NTFS 的只读限制，Windows 格式的移动硬盘和 U 盘即插即写。首次开启需要输入一次电脑密码安装驱动，之后不用再管。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-ntfs.webp"
            alt="NTFS 移动硬盘读写功能示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot rev reveal">
      <div class="spot-text">
        <h2>四种协议<br>一次覆盖</h2>
        <p class="lead">SMB、WebDAV、AFP、NFS 全都支持——群晖、威联通、坚果云、Linux 服务器、老款 Time Capsule 都能挂上。SMB 默认走 SMB2–SMB3 协商，还能开启 SMB3 多通道。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-protocols.webp"
            alt="SMB WebDAV AFP NFS 四种协议支持示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>密码留在本机<br>不依赖钥匙串</h2>
        <p class="lead">账号密码保存在本地加密文件，不写进日志，也不依赖 macOS 钥匙串。导出的诊断包里没有密码，账号名也会自动隐去。</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-encrypted.webp"
            alt="密码本地加密存储不依赖钥匙串示意"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec-light">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">全部功能</p>
      <h2>一个菜单栏图标，管好所有磁盘</h2>
    </div>
    <div class="grid">
      {app.features.map(f => (
        <div class="cell reveal">
          <div class="cell-ico">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec-darker" id="platforms">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">平台</p>
      <h2>专为 macOS 打造</h2>
    </div>
    <div class="plats" style="grid-template-columns:1fr">
      <div class="plat reveal" style="max-width:560px;margin:0 auto">
        <span class="plat-tag">macOS</span>
        <h3>菜单栏轻量工具</h3>
        <ul>
          <li>常驻菜单栏，不打扰日常使用</li>
          <li>支持 SMB / WebDAV / AFP / NFS 四种协议</li>
          <li>静默自动重连，无需用户介入</li>
          <li>NTFS 移动硬盘可读写</li>
          <li>中文 / English / 한국어 / 日本語 / Русский</li>
          <li>每天自动检查更新，一键安装</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="sec-light get" id="get">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">立即获取</p>
      <h2>下载 NetDiskMount</h2>
      <p class="lead">GitHub 免费下载，MIT 开源。当前版本 v{app.version}，需要 macOS 14 及以上，Apple 芯片与 Intel 芯片均可运行。</p>
    </div>
    <div class="get-cards" style="grid-template-columns:1fr;max-width:320px;margin-left:auto;margin-right:auto">
      <div class="get-card reveal">
        <img src="/images/icon-github.svg" alt="GitHub 图标" width="80" height="80" loading="lazy">
        <h3>GitHub</h3>
        <p>下载最新版 DMG，按芯片选择安装包，拖入「应用程序」即可使用。</p>
        <a class="btn btn-primary" href={app.downloadUrl} target="_blank" rel="noopener">{app.downloadLabel}</a>
      </div>
    </div>
    <p class="reveal" style="text-align:center;margin-top:28px">
      <a class="btn btn-outline" href={repoUrl} target="_blank" rel="noopener"><img src="/images/icon-github.svg" alt="" width="18" height="18" aria-hidden="true">在 GitHub 查看项目</a>
    </p>
  </div>
</section>

<ProductCrossLinks lang="zh" current="netdiskmount" />

</Base>
