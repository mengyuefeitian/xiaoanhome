---
import Base from '../../../layouts/Base.astro';
import { getT } from '../../../i18n/utils';

const t = getT('en');
const app = t.apps.ilaunch;
---
<Base
  title="iLaunch · Native macOS Launchpad Replacement"
  description={app.tagline}
  lang="en"
>

<section class="hero sec-dark" id="top">
  <div class="wrap">
    <p class="eyebrow">iLaunch</p>
    <h1>Bring back<br>Launchpad</h1>
    <p class="lead">{app.desc}</p>
    <p class="hero-sub"><img src="/images/icon-macos.svg" class="pi" alt="" width="17" height="17">macOS Desktop App</p>
    <div class="hero-device" style="padding-bottom:60px">
      <div class="app-showcase" style="transform:translateY(40px)">
        <img src="/images/ilaunch-icon.png" alt="iLaunch icon" class="showcase-icon" width="140" height="140" />
      </div>
    </div>
  </div>
</section>

<section class="sec-dark" id="features">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">Why iLaunch</p>
      <h2>Organize once, rely on it forever</h2>
      <p class="lead">macOS 26 replaced the classic Launchpad with a Spotlight-like Apps entry. iLaunch brings the spatial memory back.</p>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>Full-Screen Grid<br>Spatial Memory Intact</h2>
        <p class="lead">Borderless overlay, real system icons, page indicators. Rows, columns, icon size (S/M/L), and app names are all customizable in settings. Knowing which page and corner an app lives in is often faster than typing.</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/ilaunch/feature-grid.webp"
            alt="Illustration of the full-screen app grid"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot rev reveal">
      <div class="spot-text">
        <h2>Instant Search<br>Pinyin Included</h2>
        <p class="lead">Real-time filtering with full Pinyin support (type "yy" to find "音乐" — Music). Keyboard navigation, and click anywhere blank to dismiss.</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/ilaunch/feature-search.webp"
            alt="Illustration of instant Pinyin search"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>Drag Together<br>Instant Folder</h2>
        <p class="lead">Drag one app onto another to group them. The folder pops open from the tile and shrinks back when closed. 3×3 preview when closed; tap mini icons inside an open folder to launch directly. On first launch, system Apple apps are automatically collected into their own folder, and newly installed ones quietly join later — without disturbing your layout.</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/ilaunch/feature-folders.webp"
            alt="Illustration of drag-and-drop folders"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot rev reveal">
      <div class="spot-text">
        <h2>Global Hotkey<br>Summon Anytime</h2>
        <p class="lead">Default ⌥ Space, customizable in settings. Also opens from the menu bar and Dock. Launching an app instantly dismisses the full-screen grid — no lag.</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/ilaunch/feature-hotkey.webp"
            alt="Illustration of the global hotkey"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec-light">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">All Features</p>
      <h2>The classic Launchpad feel, restored</h2>
    </div>
    <div class="grid">
      {app.features.map(f => (
        <div class="cell reveal">
          <div class="cell-ico">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec-darker" id="platforms">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">Platform</p>
      <h2>Built for macOS</h2>
    </div>
    <div class="plats" style="grid-template-columns:1fr">
      <div class="plat reveal" style="max-width:560px;margin:0 auto">
        <span class="plat-tag">macOS</span>
        <h3>macOS Desktop App</h3>
        <ul>
          <li>Full-screen grid with manual layout</li>
          <li>Instant Pinyin search</li>
          <li>Folders with smart Apple grouping</li>
          <li>Configurable global hotkey</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="sec-light get" id="get">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Get iLaunch</p>
      <h2>Download iLaunch</h2>
      <p class="lead">Free and open source on GitHub.</p>
    </div>
    <div class="get-cards" style="grid-template-columns:1fr;max-width:320px;margin-left:auto;margin-right:auto">
      <div class="get-card reveal">
        <img src="/images/icon-github.svg" alt="" width="80" height="80" loading="lazy">
        <h3>GitHub</h3>
        <p>Download the latest DMG and drag it to Applications. MIT license. If Gatekeeper blocks the first launch, right-click → Open.</p>
        <a class="btn btn-primary" href={app.downloadUrl} target="_blank" rel="noopener">{app.downloadLabel}</a>
      </div>
    </div>
  </div>
</section>

</Base>
