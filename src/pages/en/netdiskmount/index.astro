---
import Base from '../../../layouts/Base.astro';
import { getT } from '../../../i18n/utils';

const t = getT('en');
const app = t.apps.autovolume;
import { buildAppJsonLd } from '../../../data/seo';
import ProductCrossLinks from '../../../components/ProductCrossLinks.astro';
const appJsonLd = buildAppJsonLd(app, 'autovolume', 'en', '/en/netdiskmount');
const repoUrl = 'https://github.com/mengyuefeitian/AutoVolume';
---
<Base
  jsonLd={appJsonLd}
  title="NetDiskMount · macOS Network Drive Auto-Mount | XiaoAn Home"
  description={app.desc}
  lang="en"
>

<section class="hero sec-dark" id="top">
  <div class="wrap">
    <p class="eyebrow">NetDiskMount · v{app.version}</p>
    <h1>Keep NAS and cloud drives<br>mounted on your Mac</h1>
    <p class="lead">{app.desc}</p>
    <p class="hero-sub"><img src="/images/icon-macos.svg" class="pi" alt="macOS logo" width="17" height="17">macOS menu bar app · network drive mount &amp; reconnect</p>
    <div class="hero-device" style="padding-bottom:60px">
      <div class="app-showcase" style="transform:translateY(40px)">
        <img src="/images/autovolume-icon.png" alt="NetDiskMount icon" class="showcase-icon" width="140" height="140" />
      </div>
    </div>
    <p style="margin-top:72px">
      <a class="btn btn-outline" href={repoUrl} target="_blank" rel="noopener"><img src="/images/icon-github.svg" alt="" width="18" height="18" style="filter:invert(1)" aria-hidden="true">View on GitHub</a>
    </p>
  </div>
</section>

<section class="sec-dark" id="features">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">Why NetDiskMount</p>
      <h2>Mount it once. Never think about it again.</h2>
      <p class="lead">After an outage, a sleep or a Wi-Fi switch, your network folders come back on their own.</p>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>Auto Reconnect.<br>Silent Recovery.</h2>
        <p class="lead">When the network drops and returns, or your Mac wakes from sleep, the network folders are mounted again. No trip to Finder's "Connect to Server", no popups.</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-reconnect.webp"
            alt="Illustration of silent auto remount after network recovery"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot rev reveal">
      <div class="spot-text">
        <h2>Set Up Once.<br>Ready at Login.</h2>
        <p class="lead">Server address, path, account, password and mount point are saved once, then mounted automatically at startup. You can even mount a single subdirectory such as smb://nas.local/share/tools.</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-subdir.webp"
            alt="Illustration of mounting a specific server subdirectory"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>NTFS Drives.<br>Plug In and Write.</h2>
        <p class="lead">Breaks through macOS's read-only limit on NTFS: Windows-formatted external disks and USB sticks mount read-write. The first switch-on asks for your Mac password once to install the driver.</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-ntfs.webp"
            alt="Illustration of NTFS external drive read and write support"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot rev reveal">
      <div class="spot-text">
        <h2>Four Protocols.<br>All Covered.</h2>
        <p class="lead">SMB, WebDAV, AFP and NFS are all supported — Synology, QNAP, WebDAV cloud drives, Linux servers and older Time Capsules. SMB negotiates SMB2–SMB3 by default, with SMB3 multichannel available.</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-protocols.webp"
            alt="Illustration of SMB WebDAV AFP and NFS protocol support"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <div class="spot reveal">
      <div class="spot-text">
        <h2>Passwords Stay Local.<br>No Keychain Needed.</h2>
        <p class="lead">Credentials live in a local encrypted file, never written to logs, and no macOS Keychain dependency. Exported diagnostics contain no passwords, and account names are redacted.</p>
      </div>
      <div class="spot-visual">
        <div class="app-showcase feature">
          <img
            src="/images/autovolume/feature-encrypted.webp"
            alt="Illustration of local encrypted password storage without Keychain"
            class="showcase-feature"
            width="320"
            height="320"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec-light">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">All Features</p>
      <h2>One menu bar icon for every disk</h2>
    </div>
    <div class="grid">
      {app.features.map(f => (
        <div class="cell reveal">
          <div class="cell-ico">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec-darker" id="platforms">
  <div class="wrap">
    <div class="spot-head reveal">
      <p class="eyebrow">Platform</p>
      <h2>Built for macOS</h2>
    </div>
    <div class="plats" style="grid-template-columns:1fr">
      <div class="plat reveal" style="max-width:560px;margin:0 auto">
        <span class="plat-tag">macOS</span>
        <h3>Menu Bar Utility</h3>
        <ul>
          <li>Lives in the menu bar, never interrupts your workflow</li>
          <li>SMB / WebDAV / AFP / NFS protocol support</li>
          <li>Silent auto-reconnect, no user intervention needed</li>
          <li>NTFS external drives read and write</li>
          <li>English / 中文 / 한국어 / 日本語 / Русский</li>
          <li>Daily update checks with one-click install</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="sec-light get" id="get">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">Get NetDiskMount</p>
      <h2>Download NetDiskMount</h2>
      <p class="lead">Free on GitHub, MIT licensed. Current version v{app.version}, requires macOS 14 or later on Apple silicon or Intel.</p>
    </div>
    <div class="get-cards" style="grid-template-columns:1fr;max-width:320px;margin-left:auto;margin-right:auto">
      <div class="get-card reveal">
        <img src="/images/icon-github.svg" alt="GitHub logo" width="80" height="80" loading="lazy">
        <h3>GitHub</h3>
        <p>Download the latest DMG for your chip and drag it to Applications.</p>
        <a class="btn btn-primary" href={app.downloadUrl} target="_blank" rel="noopener">{app.downloadLabel}</a>
      </div>
    </div>
    <p class="reveal" style="text-align:center;margin-top:28px">
      <a class="btn btn-outline" href={repoUrl} target="_blank" rel="noopener"><img src="/images/icon-github.svg" alt="" width="18" height="18" aria-hidden="true">View on GitHub</a>
    </p>
  </div>
</section>

<ProductCrossLinks lang="en" current="netdiskmount" />

</Base>
