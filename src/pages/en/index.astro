---
import Base from '../../layouts/Base.astro';
import { getT } from '../../i18n/utils';

const t = getT('en');
import { organizationSchema, webSiteSchema } from '../../data/seo';
const siteJsonLd = [organizationSchema('en'), webSiteSchema('en')];
const { apps } = t;

interface ProductCard {
  app: { name: string; nameEn: string; tagline: string; platform: readonly string[] };
  href: string;
  icon: string;
  iconAlt: string;
  /** 公开 GitHub 仓库地址，私有仓库不填则不渲染链接 */
  repo?: string;
}

const products: ProductCard[] = [
  { app: apps.arcanekey,      href: '/en/arcanekey',        icon: '/images/arcanekey-icon.png',       iconAlt: 'ArcaneKey icon',                repo: 'https://github.com/mengyuefeitian/ArcaneKey' },
  { app: apps.winterFortress, href: '/en/winter-fortress',  icon: '/images/winter-fortress-logo.svg', iconAlt: 'Winter Fortress Activity icon', repo: 'https://github.com/mengyuefeitian/winter-fortress-registration' },
  { app: apps.lumibox,        href: '/en/lumibox',          icon: '/images/lumibox-icon.png',         iconAlt: 'LumiBox icon' },
  {
    app: apps.autovolume,
    href: '/en/netdiskmount',
    icon: '/images/autovolume-icon.png',
    iconAlt: 'NetDiskMount icon',
    repo: 'https://github.com/mengyuefeitian/AutoVolume',
  },
  { app: apps.autoprint,      href: '/en/autoprint',        icon: '/images/autoprint-icon.png',       iconAlt: 'AutoPrint icon',                repo: 'https://github.com/mengyuefeitian/autoprint' },
  { app: apps.ilaunch,        href: '/en/ilaunch',          icon: '/images/ilaunch-icon.png',         iconAlt: 'iLaunch icon',                  repo: 'https://github.com/mengyuefeitian/iLaunch' },
];
---
<Base
  jsonLd={siteJsonLd}
  title="XiaoAn Home · XiaoAn Studio | HarmonyOS, macOS & WeChat Apps"
  description="Official site of XiaoAn Studio: ArcaneKey, Winter Fortress, LumiBox, NetDiskMount, AutoPrint and iLaunch — original apps for HarmonyOS, macOS and WeChat."
  lang="en"
>
  <!-- Dark hero -->
  <section class="home-hero sec-dark">
    <div class="wrap">
      <p class="eyebrow">XiaoAn Studio · Independent Developer</p>
      <h1>{t.home.heroTitle}</h1>
      <p class="lead">{t.home.appsSubtitle}</p>
      <p class="home-hero-intro">
        XiaoAn Home (www.xiaoanhome.xyz) gathers every app built by XiaoAn Studio:
        ArcaneKey keeps your two-factor codes safe on-device, LumiBox syncs your photo library
        to your own NAS, and Winter Fortress helps game alliances manage event sign-ups.
        All apps are free to get from their official stores, with release notes and privacy
        policies maintained right here on this site.
      </p>
      <div class="home-hero-apps">
        {products.map(p => (
          <a href={p.href} class="home-hero-app">
            <img src={p.icon} alt={p.iconAlt} width="72" height="72" loading="eager" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Product spots — alternating left/right -->
  <div class="home-spots">
    {products.map((p, i) => (
      <div class="wrap">
        <div class={`home-spot reveal${i % 2 === 1 ? ' rev' : ''}`}>
          <div class="home-spot-visual">
            <div class="home-spot-icon">
              <img src={p.icon} alt={p.iconAlt} width="110" height="110" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          </div>
          <div class="home-spot-text">
            <p class="platform-tag">{p.app.platform.join(' · ')}</p>
            <h2>{p.app.nameEn}</h2>
            <p class="lead">{p.app.tagline}</p>
            <div class="spot-actions">
              <a href={p.href} class="tile-cta">Learn More ›</a>
              {p.repo && (
                <a
                  href={p.repo}
                  class="gh-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${p.app.nameEn} on GitHub`}
                >
                  <img src="/images/icon-github.svg" alt="" width="16" height="16" aria-hidden="true" loading="lazy" />
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

</Base>

<style>
  .spot-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .gh-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    opacity: 0.32;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }
  .gh-link:hover,
  .gh-link:focus-visible {
    opacity: 0.85;
    background-color: rgba(0, 0, 0, 0.06);
  }
  @media (max-width: 768px) {
    .spot-actions {
      justify-content: center;
    }
  }
</style>
