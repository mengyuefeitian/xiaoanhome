---
import Legal from '../../layouts/Legal.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('legal', 'previewer-user-agreement');
if (!entry) throw new Error('Legal entry not found: previewer-user-agreement');
const { Content } = await render(entry);
---
<Legal title="预览 Previewer 用户协议" date="2026年10月24日">
  <Content />
</Legal>
