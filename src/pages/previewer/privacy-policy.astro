---
import Legal from '../../layouts/Legal.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('legal', 'previewer-privacy-policy');
if (!entry) throw new Error('Legal entry not found: previewer-privacy-policy');
const { Content } = await render(entry);
---
<Legal title="预览 Previewer 隐私政策" date="2026年10月24日">
  <Content />
</Legal>
