---
import Base from '../layouts/Base.astro';
import { getT } from '../i18n/utils';

const t = getT('zh');
import { organizationSchema, webSiteSchema } from '../data/seo';
const siteJsonLd = [organizationSchema('zh'), webSiteSchema('zh')];
const { apps } = t;

interface ProductCard {
  key: string;
  app: { name: string; nameEn: string; tagline: string; platform: readonly string[] };
  href: string;
  icon: string;
  iconAlt: string;
  /** 公开 GitHub 仓库地址，私有仓库不填则不渲染链接 */
  repo?: string;
}

const products: ProductCard[] = [
  {
    key: 'arcanekey',
    app: apps.arcanekey,
    href: '/arcanekey',
    icon: '/images/arcanekey-icon.png',
    iconAlt: '星枢令图标',
    repo: 'https://github.com/mengyuefeitian/ArcaneKey',
  },
  {
    key: 'winterFortress',
    app: apps.winterFortress,
    href: '/winter-fortress',
    icon: '/images/winter-fortress-logo.svg',
    iconAlt: '无尽冬日活动图标',
    repo: 'https://github.com/mengyuefeitian/winter-fortress-registration',
  },
  {
    key: 'lumibox',
    app: apps.lumibox,
    href: '/lumibox',
    icon: '/images/lumibox-icon.png',
    iconAlt: '拾光匣图标',
    // 仓库暂为私有，暂不展示 GitHub 链接
  },
  {
    key: 'netdiskmount',
    app: apps.autovolume,
    href: '/netdiskmount',
    icon: '/images/autovolume-icon.png',
    iconAlt: '网络磁盘挂载图标',
    repo: 'https://github.com/mengyuefeitian/AutoVolume',
  },
  {
    key: 'autoprint',
    app: apps.autoprint,
    href: '/autoprint',
    icon: '/images/autoprint-icon.png',
    iconAlt: '自动打印图标',
    repo: 'https://github.com/mengyuefeitian/autoprint',
  },
  {
    key: 'ilaunch',
    app: apps.ilaunch,
    href: '/ilaunch',
    icon: '/images/ilaunch-icon.png',
    iconAlt: '启动台图标',
    repo: 'https://github.com/mengyuefeitian/iLaunch',
  },
];
---
<Base
  jsonLd={siteJsonLd}
  title="小安之家 · 小安工作室 | HarmonyOS、macOS 与微信小程序原创应用"
  description="小安之家（www.xiaoanhome.xyz）是小安工作室的独立开发者作品集，收录星枢令、无尽冬日活动、拾光匣、网络磁盘挂载（NetDiskMount）、自动打印、启动台六款原创应用，覆盖 HarmonyOS、macOS 与微信小程序三大平台，可在应用商店免费获取，并提供完整的产品介绍、更新日志、下载入口与隐私政策。"
  lang="zh"
>
  <!-- Dark hero -->
  <section class="home-hero sec-dark">
    <div class="wrap">
      <p class="eyebrow">小安工作室 · 独立开发者</p>
      <h1>{t.home.heroTitle}</h1>
      <p class="lead">{t.home.appsSubtitle}</p>
      <p class="home-hero-intro">
        小安之家（www.xiaoanhome.xyz）收录小安工作室的全部原创应用：从保护账号安全的双因素验证器「星枢令」，
        到把照片留在自己设备之间的「拾光匣」，再到服务游戏公会的「无尽冬日活动」报名管理小程序。
        所有应用均可在对应应用商店或微信中免费获取，产品介绍、更新日志与隐私政策都在本站维护。
      </p>
      <div class="home-hero-apps">
        {products.map(p => (
          <a href={p.href} class="home-hero-app">
            <img src={p.icon} alt={p.iconAlt} width="72" height="72" loading="eager" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Product spots — alternating left/right -->
  <div class="home-spots">
    {products.map((p, i) => (
      <div class="wrap">
        <div class={`home-spot reveal${i % 2 === 1 ? ' rev' : ''}`}>
          <div class="home-spot-visual">
            <div class="home-spot-icon">
              <img src={p.icon} alt={p.iconAlt} width="110" height="110" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          </div>
          <div class="home-spot-text">
            <p class="platform-tag">{p.app.platform.join(' · ')}</p>
            <h2>{p.app.name}</h2>
            <p class="lead">{p.app.tagline}</p>
            <div class="spot-actions">
              <a href={p.href} class="tile-cta">了解详情 ›</a>
              {p.repo && (
                <a
                  href={p.repo}
                  class="gh-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`在 GitHub 查看 ${p.app.name} 项目`}
                >
                  <img src="/images/icon-github.svg" alt="" width="16" height="16" aria-hidden="true" loading="lazy" />
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

</Base>

<style>
  .spot-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .gh-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    opacity: 0.32;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }
  .gh-link:hover,
  .gh-link:focus-visible {
    opacity: 0.85;
    background-color: rgba(0, 0, 0, 0.06);
  }
  @media (max-width: 768px) {
    .spot-actions {
      justify-content: center;
    }
  }
</style>
