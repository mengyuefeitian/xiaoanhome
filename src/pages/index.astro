---
import Base from '../layouts/Base.astro';
import { getT } from '../i18n/utils';

const t = getT('zh');
import { organizationSchema, webSiteSchema } from '../data/seo';
const siteJsonLd = [organizationSchema('zh'), webSiteSchema('zh')];
const { apps } = t;

const products = [
  {
    key: 'arcanekey',
    app: apps.arcanekey,
    href: '/arcanekey',
    icon: '/images/arcanekey-icon.png',
    iconAlt: '星枢令图标',
  },
  {
    key: 'winterFortress',
    app: apps.winterFortress,
    href: '/winter-fortress',
    icon: '/images/winter-fortress-logo.svg',
    iconAlt: '无尽冬日活动图标',
  },
  {
    key: 'lumibox',
    app: apps.lumibox,
    href: '/lumibox',
    icon: '/images/lumibox-icon.png',
    iconAlt: '拾光匣图标',
  },
  {
    key: 'autovolume',
    app: apps.autovolume,
    href: '/autovolume',
    icon: '/images/autovolume-icon.png',
    iconAlt: '智卷图标',
  },
  {
    key: 'autoprint',
    app: apps.autoprint,
    href: '/autoprint',
    icon: '/images/autoprint-icon.png',
    iconAlt: '自动打印图标',
  },
  {
    key: 'ilaunch',
    app: apps.ilaunch,
    href: '/ilaunch',
    icon: '/images/ilaunch-icon.png',
    iconAlt: '启动台图标',
  },
];
---
<Base
  jsonLd={siteJsonLd}
  title="小安之家 · 小安工作室 | HarmonyOS、macOS 应用与微信小程序"
  description="小安之家是小安工作室的独立开发者作品集：星枢令（TOTP 双因素验证器）、拾光匣（NAS 私有相册同步）、无尽冬日活动（联盟活动报名管理微信小程序）、智卷、自动打印、启动台等原创应用，覆盖 HarmonyOS、macOS 与微信小程序三大平台。"
  lang="zh"
>
  <!-- Dark hero -->
  <section class="home-hero sec-dark">
    <div class="wrap">
      <p class="eyebrow">小安工作室 · 独立开发者</p>
      <h1>{t.home.heroTitle}</h1>
      <p class="lead">{t.home.appsSubtitle}</p>
      <p class="home-hero-intro">
        小安之家（www.xiaoanhome.xyz）收录小安工作室的全部原创应用：从保护账号安全的双因素验证器「星枢令」，
        到把照片留在自己设备之间的「拾光匣」，再到服务游戏公会的「无尽冬日活动」报名管理小程序。
        所有应用均可在对应应用商店或微信中免费获取，产品介绍、更新日志与隐私政策都在本站维护。
      </p>
      <div class="home-hero-apps">
        {products.map(p => (
          <a href={p.href} class="home-hero-app">
            <img src={p.icon} alt={p.iconAlt} width="72" height="72" loading="eager" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Product spots — alternating left/right -->
  <div class="home-spots">
    {products.map((p, i) => (
      <div class="wrap">
        <div class={`home-spot reveal${i % 2 === 1 ? ' rev' : ''}`}>
          <div class="home-spot-visual">
            <div class="home-spot-icon">
              <img src={p.icon} alt={p.iconAlt} width="110" height="110" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          </div>
          <div class="home-spot-text">
            <p class="platform-tag">{p.app.platform.join(' · ')}</p>
            <h2>{p.app.name}</h2>
            <p class="lead">{p.app.tagline}</p>
            <a href={p.href} class="tile-cta">了解详情 ›</a>
          </div>
        </div>
      </div>
    ))}
  </div>

</Base>
